# رمز البوت من BotFather
TELEGRAM_BOT_TOKEN=123456789:ضع_رمز_البوت_هنا

# مفتاح Gemini API من Google AI Studio
GEMINI_API_KEY=ضع_مفتاح_Gemini_هنا
GEMINI_MODEL=gemini-2.0-flash

# قاعدة البيانات المحلية؛ على Railway استخدم Volume إذا أردت بقاء SQLite بعد إعادة النشر
DATABASE_PATH=data/assistant.sqlite3

# المنطقة الزمنية ووقت الملخص الصباحي بصيغة 24 ساعة
TIMEZONE=Asia/Riyadh
DAILY_SUMMARY_TIME=08:00

# اتركها primary أو ضع معرّف تقويم محدداً
GOOGLE_CALENDAR_ID=primary

# الصق JSON لمفاتيح OAuth (ملف credentials.json) كسطر واحد في Railway
GOOGLE_CREDENTIALS_JSON=

# الصق JSON لمخرجات scripts/authorize_calendar.py كسطر واحد في Railway
GOOGLE_TOKEN_JSON=

# معرّفات مستخدمي تيليجرام المسموح لهم، مفصولة بفواصل. تركه فارغاً يسمح للجميع.
ALLOWED_USER_IDS=
